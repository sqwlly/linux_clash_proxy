Screen {
    background: #0f1419;
    color: #d9e2ec;
}

Header {
    background: #101821;
    color: #5eead4;
    height: 1;
    text-style: bold;
}

Footer {
    background: #101821;
    color: #8794a6;
    height: 1;
}

Footer > .footer--key {
    color: #f2c166;
}

TabbedContent,
TabbedContent > ContentSwitcher,
#main-tabs {
    height: 1fr;
}

Tabs {
    background: #101821;
    color: #8794a6;
    height: 2;
    padding: 0 1;
    border-bottom: solid #253241;
}

Tab {
    color: #8794a6;
    background: #0f1419;
    padding: 0 1;
}

.compact Tabs {
    height: 2;
    padding: 0;
}

.compact Tab {
    padding: 0 1;
}

Tab:hover {
    color: #e8edf3;
    background: #1b2634;
}

Tab:focus {
    color: #5eead4;
    background: #172635;
}

Tab.-active {
    color: #071013;
    background: #5eead4;
    text-style: bold;
}

TabPane {
    padding: 0 1;
    height: 1fr;
}

.status-card {
    width: 1fr;
    height: auto;
    min-height: 6;
    border: solid #2b394b;
    padding: 0 1 1 1;
    margin: 0 1 0 0;
    background: #151c26;
}

.status-card-title {
    color: #5eead4;
    text-style: bold;
    height: 1;
    padding: 0;
    margin: 0 0 0 0;
}

.runtime-card {
    border-left: tall #5eead4;
}

.ai-card {
    border-left: tall #f2c166;
}

.traffic-card {
    border-left: tall #a3e635;
}

.ai-card .status-card-title {
    color: #f2c166;
}

.traffic-card .status-card-title {
    color: #a3e635;
}

.proxy-sidebar .proxy-group-title,
.ai-selector-panel .ai-route-title,
.output-panel .panel-title {
    color: #f2c166;
}

.summary-panel .panel-title {
    color: #a3e635;
}

.label-key {
    color: #8794a6;
    width: 8;
}

.metric-value {
    color: #e8edf3;
    background: transparent;
    border: none;
    padding: 0 1;
    width: 1fr;
    min-height: 1;
}

DataTable {
    height: 1fr;
    background: #0d1218;
    color: #d9e2ec;
    border: none;
    padding: 0;
}

DataTable > .datatable--header {
    background: #172635;
    color: #5eead4;
    text-style: bold;
}

DataTable > .datatable--odd-row {
    background: #101820;
}

DataTable > .datatable--cursor {
    background: #24354a;
}

DataTable:focus > .datatable--cursor {
    background: #315b68;
    color: #f8fbfc;
    text-style: bold;
}

DataTable:focus {
    border-left: tall #5eead4;
}

Input,
.subscription-input {
    height: 2;
    background: #0d1218;
    color: #e8edf3;
    border: none;
    padding: 0 1;
}

Input:focus,
.subscription-input:focus {
    border-left: tall #5eead4;
    background: #111a23;
}

TextArea {
    background: #0d1218;
    color: #d9e2ec;
}

TextArea:focus {
    border: tall #5eead4;
    background: #101820;
}

Checkbox {
    color: #d9e2ec;
    margin-left: 1;
    margin-right: 0;
    min-width: 8;
    height: 1;
    max-height: 1;
}

Checkbox:focus {
    color: #5eead4;
}

Switch {
    margin-right: 1;
}

.proxy-group-card {
    border: solid #2b394b;
    padding: 0 1 0 1;
    margin: 0 1 0 0;
    height: 1fr;
    background: #151c26;
}

.proxy-sidebar {
    border-left: tall #f2c166;
}

.proxy-main {
    border-left: tall #5eead4;
}

.split-sidebar {
    width: 1fr;
    min-width: 20;
}

.split-main {
    width: 4fr;
    min-width: 32;
}

.workbench-row {
    height: 1fr;
}

.compact-row {
    height: auto;
}

.compact-row .panel,
.compact-row .form-panel,
.compact-row .summary-panel,
.compact-row .ai-route-panel {
    height: auto;
}

.input-row {
    height: auto;
}

.proxy-group-title {
    color: #5eead4;
    text-style: bold;
    height: 1;
    padding: 0;
}

.node-current {
    color: #a3e635;
    text-style: none;
    height: 1;
    width: 1fr;
    background: transparent;
    border: none;
    padding: 0 1;
}

.ai-route-panel {
    border: solid #2b394b;
    padding: 0 1;
    margin: 0 1 0 0;
    background: #151c26;
    width: 1fr;
    height: auto;
}

.ai-selector-panel {
    border-left: tall #f2c166;
}

.ai-chain-panel {
    border-left: tall #5eead4;
    margin-right: 0;
}

.ai-route-title {
    color: #f2c166;
    text-style: bold;
    height: 1;
    padding: 0;
}

.log-viewer {
    height: 1fr;
    background: #0d1218;
    border: none;
    padding: 0 1;
}

.log-viewer:focus {
    border-left: tall #f2c166;
}

.config-editor {
    height: 1fr;
    border: none;
    padding: 0 1;
}

.config-editor:focus {
    border-left: tall #a3e635;
}

.subscription-input {
    width: 1fr;
    margin: 0 1 0 0;
}

.table-filter {
    height: 2;
    margin: 0;
    background: #101820;
    color: #e8edf3;
}

.toolbar {
    height: auto;
    min-height: 1;
    margin: 0;
    padding: 0;
    align: left middle;
}

.action-button {
    width: auto;
    min-width: 6;
    height: 1;
    max-height: 1;
    margin: 0 1 0 0;
    padding: 0 1;
    background: #1b2633;
    color: #d9e2ec;
    border: none;
    text-style: none;
}

.action-button:hover {
    background: #26364a;
}

.action-button:focus {
    border-left: tall #5eead4;
    background: #223348;
    color: #f8fbfc;
    text-style: bold;
}

.action-button.-active {
    background: #5eead4;
    color: #071013;
}

.primary-button {
    background: #165d72;
    color: #ecfeff;
}

.primary-button:hover {
    background: #0e7490;
}

.primary-button:focus {
    border-left: tall #5eead4;
    background: #0e7490;
}

.success-button {
    background: #365314;
    color: #f7fee7;
}

.success-button:hover,
.success-button:focus {
    background: #4d7c0f;
}

.danger-button {
    background: #1b1418;
    color: #fb7185;
}

.danger-button:hover,
.danger-button:focus {
    background: #3d1c24;
    border-left: tall #fb7185;
    color: #fecdd3;
}

.danger-button.-active {
    background: #fb7185;
    color: #071013;
}

.muted-button {
    background: transparent;
    color: #8b98aa;
}

.muted-button:hover,
.muted-button:focus {
    background: #1a2230;
    color: #e8edf3;
}

/* Textual 8 Toast 组件样式（原 .notification* 选择器从未匹配到任何节点，死代码） */
Toast {
    background: #5eead4;
    color: #071013;
}

Toast .toast--title {
    color: #071013;
}

/* 代码库中“成功”类提示均用 severity="information"（无独立 success 级别） */
Toast.-information {
    background: #a3e635;
}

Toast.-error {
    background: #fb7185;
}

#dashboard-grid {
    height: auto;
}

.dashboard-row {
    height: auto;
    margin-bottom: 0;
}

.field-row {
    height: auto;
    margin-bottom: 0;
}

.page-title {
    color: #e8edf3;
    text-style: bold;
    background: transparent;
    border-left: none;
    border-bottom: none;
    margin: 0;
    padding: 0;
    height: 1;
}

.panel {
    border: solid #2b394b;
    background: #151c26;
    padding: 0 1;
    margin: 0;
}

.panel-title {
    color: #f2c166;
    text-style: bold;
    height: 1;
    padding: 0;
    background: transparent;
}

.panel-header {
    height: 1;
    align: left middle;
}

.panel-header .panel-title,
.panel-header .proxy-group-title,
.panel-header .ai-route-title {
    width: auto;
    min-width: 8;
}

.panel-header .status-strip,
.panel-header .path-label {
    width: 1fr;
    text-align: right;
    background: transparent;
    padding: 0 0 0 1;
}

.form-panel {
    height: auto;
    border-left: tall #5eead4;
}

.output-panel {
    height: 1fr;
    border-left: tall #f2c166;
}

.summary-panel {
    border-left: tall #a3e635;
}

.output-area {
    height: 1fr;
    border: none;
    background: #0d1218;
}

.output-area:focus {
    border-left: tall #f2c166;
}

.current-info {
    color: #d9e2ec;
    background: transparent;
    border: none;
    padding: 0;
    width: 1fr;
    height: auto;
    min-height: 1;
}

.path-label {
    color: #8794a6;
    background: transparent;
    border: none;
    padding: 0;
    width: 1fr;
}

.status-strip {
    color: #8794a6;
    background: transparent;
    border: none;
    padding: 0;
    height: 1;
}

.action-status {
    color: #8794a6;
    background: transparent;
    border: none;
    padding: 0;
    height: auto;
    min-height: 1;
    margin-top: 0;
}

.compact .label-key {
    width: 6;
}

.compact #dashboard-grid {
    layout: grid;
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    grid-rows: 8 6;
    height: 1fr;
}

.compact #dashboard-grid .status-card {
    width: 1fr;
    min-height: 4;
    margin: 0;
}

.compact #dashboard-grid .runtime-card {
    min-height: 8;
}

.compact #dashboard-grid .traffic-card {
    column-span: 2;
}

.compact .split-sidebar {
    min-width: 16;
}

.compact .split-main {
    min-width: 28;
}

.compact .action-button {
    min-width: 4;
    margin: 0 1 0 0;
    padding: 0 1;
}

.compact Checkbox {
    min-width: 10;
}
