/* CProxy TUI 主题系统：
 *
 *   全部颜色均使用 TCSS 主题变量（$primary / $secondary / $warning / $success /
 *   $error / $foreground / $background / $surface / $panel 及其 *-muted 派生色），
 *   由 ``app.py`` 的 ``DARK_THEME`` / ``LIGHT_THEME`` 注入。切换深浅主题（Ctrl+T）时
 *   所有组件与边框自动保持高对比度，不再硬编码深色十六进制值。
 *
 *   主题变量值见 ``cproxy.tui.app.DARK_THEME`` 与 ``LIGHT_THEME``。
 *
 * ────────────────────────────────────────────────────────────────────────────
 * 间距 / 边框约定
 * ────────────────────────────────────────────────────────────────────────────
 *   TCSS 不支持自定义变量，但本项目约定一致的内边距 / 外边距常量，
 *   新增 widget 时请沿用：
 *
 *     - 卡片内 padding  : 0 1     (左右各 1 列，上下 0)
 *     - 卡片外 margin   : 0 1 0 0 (右侧留 1 列间距，下方不强制)
 *     - 面板标题 height : 1        (单行)
 *     - 行高 height     : auto     (让内容自适应，不要写死)
 *
 *   边框风格统一为「细边 + 左侧粗强调条」：
 *     - .panel { border: solid $secondary 40% } 给所有 panel 一个中性细边
 *     - .form-panel / .output-panel / .summary-panel 在 .panel 之上叠
 *       加 border-left: tall $primary/$warning/$success
 *     - .status-card / .proxy-group-card / .ai-route-panel 走同一套
 */

Screen {
    background: $background;
    color: $foreground;
}

Header {
    background: $panel;
    color: $primary;
    height: 1;
    text-style: bold;
}

Footer {
    background: $panel;
    color: $secondary;
    height: 1;
}

Footer > .footer--key {
    color: $warning;
}

TabbedContent,
TabbedContent > ContentSwitcher,
#main-tabs {
    height: 1fr;
}

Tabs {
    background: $panel;
    color: $secondary;
    height: 2;
    padding: 0 1;
    border-bottom: solid $secondary 35%;
}

Tab {
    color: $secondary;
    background: $background;
    padding: 0 1;
}

.compact Tabs {
    height: 2;
    padding: 0;
}

.compact Tab {
    padding: 0 1;
}

Tab:hover {
    color: $foreground;
    background: $surface;
}

Tab:focus {
    color: $primary;
    background: $surface;
}

Tab.-active {
    color: auto;
    background: $primary;
    text-style: bold;
}

TabPane {
    padding: 0 1;
    height: 1fr;
}

.status-card {
    width: 1fr;
    height: auto;
    min-height: 6;
    border: solid $secondary 40%;
    padding: 0 1 1 1;
    margin: 0 1 0 0;
    background: $surface;
}

.status-card-title {
    color: $primary;
    text-style: bold;
    height: 1;
    padding: 0;
    margin: 0 0 0 0;
}

.runtime-card {
    border-left: tall $primary;
}

.ai-card {
    border-left: tall $warning;
}

.traffic-card {
    border-left: tall $success;
}

.ai-card .status-card-title {
    color: $warning;
}

.traffic-card .status-card-title {
    color: $success;
}

.proxy-sidebar .proxy-group-title,
.ai-selector-panel .ai-route-title,
.output-panel .panel-title {
    color: $warning;
}

.summary-panel .panel-title {
    color: $success;
}

.label-key {
    color: $secondary;
    width: 8;
}

.metric-value {
    color: $foreground;
    background: transparent;
    border: none;
    padding: 0 1;
    width: 1fr;
    min-height: 1;
}

DataTable {
    height: 1fr;
    background: $background;
    color: $foreground;
    border: none;
    padding: 0;
}

DataTable > .datatable--header {
    background: $panel;
    color: $primary;
    text-style: bold;
}

DataTable > .datatable--odd-row {
    background: $surface;
}

DataTable > .datatable--cursor {
    background: $primary-muted;
    color: $foreground;
}

DataTable:focus > .datatable--cursor {
    background: $primary;
    color: auto;
    text-style: bold;
}

DataTable:focus {
    border-left: tall $primary;
}

Input,
.subscription-input {
    height: 2;
    background: $background;
    color: $foreground;
    border: none;
    padding: 0 1;
}

Input:focus,
.subscription-input:focus {
    border-left: tall $primary;
    background: $surface;
}

TextArea {
    background: $background;
    color: $foreground;
}

TextArea:focus {
    border: tall $primary;
    background: $surface;
}

Checkbox {
    color: $foreground;
    margin-left: 1;
    margin-right: 0;
    min-width: 8;
    height: 1;
    max-height: 1;
}

Checkbox:focus {
    color: $primary;
}

Switch {
    margin-right: 1;
}

.proxy-group-card {
    border: solid $secondary 40%;
    padding: 0 1 0 1;
    margin: 0 1 0 0;
    height: 1fr;
    background: $surface;
}

.proxy-sidebar {
    border-left: tall $warning;
}

.proxy-main {
    border-left: tall $primary;
}

.split-sidebar {
    width: 1fr;
    min-width: 20;
}

.split-main {
    width: 4fr;
    min-width: 32;
}

.workbench-row {
    height: 1fr;
}

.compact-row {
    height: auto;
}

.compact-row .panel,
.compact-row .form-panel,
.compact-row .summary-panel,
.compact-row .ai-route-panel {
    height: auto;
}

.input-row {
    height: auto;
}

.proxy-group-title {
    color: $primary;
    text-style: bold;
    height: 1;
    padding: 0;
}

.node-current {
    color: $success;
    text-style: none;
    height: 1;
    width: 1fr;
    background: transparent;
    border: none;
    padding: 0 1;
}

.ai-route-panel {
    border: solid $secondary 40%;
    padding: 0 1;
    margin: 0 1 0 0;
    background: $surface;
    width: 1fr;
    height: auto;
}

.ai-selector-panel {
    border-left: tall $warning;
}

.ai-chain-panel {
    border-left: tall $primary;
    margin-right: 0;
}

.ai-route-title {
    color: $warning;
    text-style: bold;
    height: 1;
    padding: 0;
}

.log-viewer {
    height: 1fr;
    background: $background;
    border: none;
    padding: 0 1;
}

.log-viewer:focus {
    border-left: tall $warning;
}

.config-editor {
    height: 1fr;
    border: none;
    padding: 0 1;
}

.config-editor:focus {
    border-left: tall $success;
}

.subscription-input {
    width: 1fr;
    margin: 0 1 0 0;
}

.table-filter {
    height: 2;
    margin: 0;
    background: $background;
    color: $foreground;
}

.toolbar {
    height: auto;
    min-height: 1;
    margin: 0;
    padding: 0;
    align: left middle;
}

.action-button {
    width: auto;
    min-width: 6;
    height: 1;
    max-height: 1;
    margin: 0 1 0 0;
    padding: 0 1;
    background: $panel;
    color: $foreground;
    border: none;
    text-style: none;
}

.action-button:hover {
    background: $surface;
}

.action-button:focus {
    border-left: tall $primary;
    background: $primary-muted;
    color: $foreground;
    text-style: bold;
}

.action-button.-active {
    background: $primary;
    color: auto;
}

.primary-button {
    background: $primary-muted;
    color: $foreground;
}

.primary-button:hover {
    background: $primary;
    color: auto;
}

.primary-button:focus {
    border-left: tall $primary;
    background: $primary;
    color: auto;
}

.success-button {
    background: $success-muted;
    color: $foreground;
}

.success-button:hover,
.success-button:focus {
    background: $success;
    color: auto;
}

.danger-button {
    background: $error-muted;
    color: $error;
}

.danger-button:hover,
.danger-button:focus {
    background: $error;
    border-left: tall $error;
    color: auto;
}

.danger-button.-active {
    background: $error;
    color: auto;
}

.muted-button {
    background: transparent;
    color: $secondary;
}

.muted-button:hover,
.muted-button:focus {
    background: $panel;
    color: $foreground;
}

/* Toast 提示：按 severity 映射主题语义色，文本用 auto 自动匹配深浅底对比度 */
Toast {
    background: $primary;
    color: auto;
}

Toast.-information {
    background: $success;
    color: auto;
}

Toast.-warning {
    background: $warning;
    color: auto;
}

Toast.-error {
    background: $error;
    color: auto;
}

#dashboard-grid {
    height: auto;
}

.dashboard-row {
    height: auto;
    margin-bottom: 0;
}

.field-row {
    height: auto;
    margin-bottom: 0;
}

.panel {
    border: solid $secondary 40%;
    background: $surface;
    padding: 0 1;
    margin: 0;
}

.panel-title {
    color: $warning;
    text-style: bold;
    height: 1;
    padding: 0;
    background: transparent;
}

.panel-header {
    height: 1;
    align: left middle;
}

.panel-header .panel-title,
.panel-header .proxy-group-title,
.panel-header .ai-route-title {
    width: auto;
    min-width: 8;
}

.panel-header .status-strip,
.panel-header .path-label {
    width: 1fr;
    text-align: right;
    background: transparent;
    padding: 0 0 0 1;
}

.form-panel {
    height: auto;
    border-left: tall $primary;
}

.output-panel {
    height: 1fr;
    border-left: tall $warning;
}

.summary-panel {
    border-left: tall $success;
}

.output-area {
    height: 1fr;
    border: none;
    background: $background;
}

.output-area:focus {
    border-left: tall $warning;
}

.current-info {
    color: $foreground;
    background: transparent;
    border: none;
    padding: 0;
    width: 1fr;
    height: auto;
    min-height: 1;
}

.path-label {
    color: $secondary;
    background: transparent;
    border: none;
    padding: 0;
    width: 1fr;
}

.status-strip {
    color: $secondary;
    background: transparent;
    border: none;
    padding: 0;
    height: 1;
}

.action-status {
    color: $secondary;
    background: transparent;
    border: none;
    padding: 0;
    height: auto;
    min-height: 1;
    margin-top: 0;
}

.compact .label-key {
    width: 6;
}

/* dashboard 紧凑布局：行高自动自适应，避免窄终端（<100 列）挤出 traffic 卡片 */
.compact #dashboard-grid {
    layout: grid;
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    grid-rows: auto auto;
    height: 1fr;
}

.compact #dashboard-grid .status-card {
    width: 1fr;
    min-height: 4;
    margin: 0;
}

.compact #dashboard-grid .runtime-card {
    min-height: 8;
}

.compact #dashboard-grid .traffic-card {
    column-span: 2;
}

.compact .split-sidebar {
    min-width: 16;
}

.compact .split-main {
    min-width: 28;
}

.compact .action-button {
    min-width: 4;
    margin: 0 1 0 0;
    padding: 0 1;
}

.compact Checkbox {
    min-width: 10;
}
