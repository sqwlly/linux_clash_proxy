/* CProxy TUI 主题系统：
 *
 *   关键语义色用 TCSS 变量（$primary / $warning / $success / $error /
 *   $foreground / $background / $surface / $panel），由 ``app.py`` 的
 *   ``DARK_THEME`` / ``LIGHT_THEME`` 注入。切换主题时，CSS 里所有
 *   ``$primary`` 引用都自动跟着换。
 *
 *   唯一保留硬编码的非语义色：
 *     - 边框灰 #2b394b / #253241 — 卡片边线，跨主题共用灰
 *     - 行间隔色 #24354a / #1b2634 — DataTable 行高亮
 *     - 文本「亮一档」#e8edf3 / #f8fbfc — 在 muted 之上的强调层
 *
 *   主题变量值见 ``cproxy.tui.app.DARK_THEME`` 与 ``LIGHT_THEME``。
 *
 * ────────────────────────────────────────────────────────────────────────────
 * 间距 / 边框约定
 * ────────────────────────────────────────────────────────────────────────────
 *   TCSS 不支持自定义变量，但本项目约定一致的内边距 / 外边距常量，
 *   新增 widget 时请沿用：
 *
 *     - 卡片内 padding  : 0 1     (左右各 1 列，上下 0)
 *     - 卡片外 margin   : 0 1 0 0 (右侧留 1 列间距，下方不强制)
 *     - 面板标题 height : 1        (单行)
 *     - 行高 height     : auto     (让内容自适应，不要写死)
 *
 *   边框风格统一为「细灰边 + 左侧粗强调条」：
 *     - .panel { border: solid #2b394b } 给所有 panel 一个细灰边
 *     - .form-panel / .output-panel / .summary-panel 在 .panel 之上叠
 *       加 border-left: tall #xxx，颜色由语义（primary/warning/success）决定
 *     - .status-card / .proxy-group-card / .ai-route-panel 走同一套：
 *       先 .xxx-card 拿到细灰边，再叠 .xxx-{role}-card 的 border-left 强调
 *
 *   这样 ``output-panel`` 和 ``status-card`` 视觉上一致（同款边框 + 同款强调条），
 *   不会让人误以为是两类不同的组件。
 */

Screen {
    background: $background;
    color: $foreground;
}

Header {
    background: $panel;
    color: $primary;
    height: 1;
    text-style: bold;
}

Footer {
    background: $panel;
    color: $secondary;
    height: 1;
}

Footer > .footer--key {
    color: $warning;
}

TabbedContent,
TabbedContent > ContentSwitcher,
#main-tabs {
    height: 1fr;
}

Tabs {
    background: $panel;
    color: $secondary;
    height: 2;
    padding: 0 1;
    border-bottom: solid #253241;
}

Tab {
    color: $secondary;
    background: $background;
    padding: 0 1;
}

.compact Tabs {
    height: 2;
    padding: 0;
}

.compact Tab {
    padding: 0 1;
}

Tab:hover {
    color: #e8edf3;
    background: #1b2634;
}

Tab:focus {
    color: $primary;
    background: #172635;
}

Tab.-active {
    color: #071013;
    background: $primary;
    text-style: bold;
}

TabPane {
    padding: 0 1;
    height: 1fr;
}

.status-card {
    width: 1fr;
    height: auto;
    min-height: 6;
    border: solid #2b394b;
    padding: 0 1 1 1;
    margin: 0 1 0 0;
    background: $surface;
}

.status-card-title {
    color: $primary;
    text-style: bold;
    height: 1;
    padding: 0;
    margin: 0 0 0 0;
}

.runtime-card {
    border-left: tall $primary;
}

.ai-card {
    border-left: tall $warning;
}

.traffic-card {
    border-left: tall $success;
}

.ai-card .status-card-title {
    color: $warning;
}

.traffic-card .status-card-title {
    color: $success;
}

.proxy-sidebar .proxy-group-title,
.ai-selector-panel .ai-route-title,
.output-panel .panel-title {
    color: $warning;
}

.summary-panel .panel-title {
    color: $success;
}

/* muted 文本：原来 #8794a6 在 $surface（#151c26）底色上对比度偏低（WCAG ~3.2），
 * 调到 #9aa8bc 后 ~3.9，仍不算完美但已高于「勉强可读」线，并保留 muted 感。 */
.label-key {
    color: #9aa8bc;
    width: 8;
}

.metric-value {
    color: #e8edf3;
    background: transparent;
    border: none;
    padding: 0 1;
    width: 1fr;
    min-height: 1;
}

DataTable {
    height: 1fr;
    background: #0d1218;
    color: $foreground;
    border: none;
    padding: 0;
}

DataTable > .datatable--header {
    background: #172635;
    color: $primary;
    text-style: bold;
}

DataTable > .datatable--odd-row {
    background: #101820;
}

DataTable > .datatable--cursor {
    background: #24354a;
}

DataTable:focus > .datatable--cursor {
    background: #315b68;
    color: #f8fbfc;
    text-style: bold;
}

DataTable:focus {
    border-left: tall $primary;
}

Input,
.subscription-input {
    height: 2;
    background: #0d1218;
    color: #e8edf3;
    border: none;
    padding: 0 1;
}

Input:focus,
.subscription-input:focus {
    border-left: tall $primary;
    background: #111a23;
}

TextArea {
    background: #0d1218;
    color: $foreground;
}

TextArea:focus {
    border: tall $primary;
    background: #101820;
}

Checkbox {
    color: $foreground;
    margin-left: 1;
    margin-right: 0;
    min-width: 8;
    height: 1;
    max-height: 1;
}

Checkbox:focus {
    color: $primary;
}

Switch {
    margin-right: 1;
}

.proxy-group-card {
    border: solid #2b394b;
    padding: 0 1 0 1;
    margin: 0 1 0 0;
    height: 1fr;
    background: $surface;
}

.proxy-sidebar {
    border-left: tall $warning;
}

.proxy-main {
    border-left: tall $primary;
}

.split-sidebar {
    width: 1fr;
    min-width: 20;
}

.split-main {
    width: 4fr;
    min-width: 32;
}

.workbench-row {
    height: 1fr;
}

.compact-row {
    height: auto;
}

.compact-row .panel,
.compact-row .form-panel,
.compact-row .summary-panel,
.compact-row .ai-route-panel {
    height: auto;
}

.input-row {
    height: auto;
}

.proxy-group-title {
    color: $primary;
    text-style: bold;
    height: 1;
    padding: 0;
}

.node-current {
    color: $success;
    text-style: none;
    height: 1;
    width: 1fr;
    background: transparent;
    border: none;
    padding: 0 1;
}

.ai-route-panel {
    border: solid #2b394b;
    padding: 0 1;
    margin: 0 1 0 0;
    background: $surface;
    width: 1fr;
    height: auto;
}

.ai-selector-panel {
    border-left: tall $warning;
}

.ai-chain-panel {
    border-left: tall $primary;
    margin-right: 0;
}

.ai-route-title {
    color: $warning;
    text-style: bold;
    height: 1;
    padding: 0;
}

.log-viewer {
    height: 1fr;
    background: #0d1218;
    border: none;
    padding: 0 1;
}

.log-viewer:focus {
    border-left: tall $warning;
}

.config-editor {
    height: 1fr;
    border: none;
    padding: 0 1;
}

.config-editor:focus {
    border-left: tall $success;
}

.subscription-input {
    width: 1fr;
    margin: 0 1 0 0;
}

.table-filter {
    height: 2;
    margin: 0;
    background: #101820;
    color: #e8edf3;
}

.toolbar {
    height: auto;
    min-height: 1;
    margin: 0;
    padding: 0;
    align: left middle;
}

.action-button {
    width: auto;
    min-width: 6;
    height: 1;
    max-height: 1;
    margin: 0 1 0 0;
    padding: 0 1;
    background: #1b2633;
    color: $foreground;
    border: none;
    text-style: none;
}

.action-button:hover {
    background: #26364a;
}

.action-button:focus {
    border-left: tall $primary;
    background: #223348;
    color: #f8fbfc;
    text-style: bold;
}

.action-button.-active {
    background: $primary;
    color: #071013;
}

.primary-button {
    background: #165d72;
    color: #ecfeff;
}

.primary-button:hover {
    background: #0e7490;
}

.primary-button:focus {
    border-left: tall $primary;
    background: #0e7490;
}

.success-button {
    background: #365314;
    color: #f7fee7;
}

.success-button:hover,
.success-button:focus {
    background: #4d7c0f;
}

.danger-button {
    background: #1b1418;
    color: $error;
}

.danger-button:hover,
.danger-button:focus {
    background: #3d1c24;
    border-left: tall $error;
    color: #fecdd3;
}

.danger-button.-active {
    background: $error;
    color: #071013;
}

.muted-button {
    background: transparent;
    color: #9aa8bc;
}

.muted-button:hover,
.muted-button:focus {
    background: #1a2230;
    color: #e8edf3;
}

/* Toast 提示：默认主色（$primary）背景作为「普通通知」；information 走成功色
 * 替代缺失的 success 严重级；error 走错误色。无独立的 .toast--title 选择器：
 * Textual 8 的 Toast widget 不再暴露该内部类，原样式属历史遗留。 */
Toast {
    background: $primary;
    color: #071013;
}

/* 代码库中「成功」类提示均用 severity="information"（无独立 success 级别） */
Toast.-information {
    background: $success;
}

Toast.-error {
    background: $error;
}

#dashboard-grid {
    height: auto;
}

.dashboard-row {
    height: auto;
    margin-bottom: 0;
}

.field-row {
    height: auto;
    margin-bottom: 0;
}

.page-title {
    color: #e8edf3;
    text-style: bold;
    background: transparent;
    border-left: none;
    border-bottom: none;
    margin: 0;
    padding: 0;
    height: 1;
}

.panel {
    border: solid #2b394b;
    background: $surface;
    padding: 0 1;
    margin: 0;
}

.panel-title {
    color: $warning;
    text-style: bold;
    height: 1;
    padding: 0;
    background: transparent;
}

.panel-header {
    height: 1;
    align: left middle;
}

.panel-header .panel-title,
.panel-header .proxy-group-title,
.panel-header .ai-route-title {
    width: auto;
    min-width: 8;
}

.panel-header .status-strip,
.panel-header .path-label {
    width: 1fr;
    text-align: right;
    background: transparent;
    padding: 0 0 0 1;
}

.form-panel {
    height: auto;
    border-left: tall $primary;
}

.output-panel {
    height: 1fr;
    border-left: tall $warning;
}

.summary-panel {
    border-left: tall $success;
}

.output-area {
    height: 1fr;
    border: none;
    background: #0d1218;
}

.output-area:focus {
    border-left: tall $warning;
}

.current-info {
    color: $foreground;
    background: transparent;
    border: none;
    padding: 0;
    width: 1fr;
    height: auto;
    min-height: 1;
}

.path-label {
    color: #9aa8bc;
    background: transparent;
    border: none;
    padding: 0;
    width: 1fr;
}

.status-strip {
    color: #9aa8bc;
    background: transparent;
    border: none;
    padding: 0;
    height: 1;
}

.action-status {
    color: #9aa8bc;
    background: transparent;
    border: none;
    padding: 0;
    height: auto;
    min-height: 1;
    margin-top: 0;
}

.compact .label-key {
    width: 6;
}

/* dashboard 紧凑布局：行高不再写死（8/6），改 auto 让卡片随内容自适应；
 * 旧写法在窄终端（<100 列）会把 traffic 卡片挤出可见区域。 */
.compact #dashboard-grid {
    layout: grid;
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    grid-rows: auto auto;
    height: 1fr;
}

.compact #dashboard-grid .status-card {
    width: 1fr;
    min-height: 4;
    margin: 0;
}

.compact #dashboard-grid .runtime-card {
    min-height: 8;
}

.compact #dashboard-grid .traffic-card {
    column-span: 2;
}

.compact .split-sidebar {
    min-width: 16;
}

.compact .split-main {
    min-width: 28;
}

.compact .action-button {
    min-width: 4;
    margin: 0 1 0 0;
    padding: 0 1;
}

.compact Checkbox {
    min-width: 10;
}
