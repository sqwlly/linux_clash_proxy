Screen {
    background: #0f1419;
    color: #d9e2ec;
}

Header {
    background: #101821;
    color: #5eead4;
    height: 1;
    text-style: bold;
}

Footer {
    background: #101821;
    color: #8794a6;
    height: 1;
}

Footer > .footer--key {
    color: #f2c166;
}

TabbedContent,
TabbedContent > ContentSwitcher,
#main-tabs {
    height: 1fr;
}

Tabs {
    background: #101821;
    color: #8794a6;
    height: 3;
    padding: 0 2;
    border-bottom: solid #253241;
}

Tab {
    color: #8794a6;
    background: #0f1419;
    padding: 0 1;
}

Tab:hover {
    color: #e8edf3;
    background: #1b2634;
}

Tab:focus {
    color: #5eead4;
    background: #172635;
}

Tab.-active {
    color: #071013;
    background: #5eead4;
    text-style: bold;
}

TabPane {
    padding: 1 2;
    height: 1fr;
}

.status-card {
    width: 1fr;
    height: auto;
    min-height: 11;
    border: solid #2b394b;
    padding: 1 2;
    margin: 0 1 1 0;
    background: #151c26;
}

.status-card-title {
    color: #5eead4;
    text-style: bold;
    margin-bottom: 1;
}

.runtime-card {
    border-left: tall #5eead4;
}

.ai-card {
    border-left: tall #f2c166;
}

.traffic-card {
    border-left: tall #a3e635;
}

.ai-card .status-card-title {
    color: #f2c166;
}

.traffic-card .status-card-title {
    color: #a3e635;
}

.proxy-sidebar .proxy-group-title,
.ai-selector-panel .ai-route-title,
.output-panel .panel-title {
    color: #f2c166;
}

.summary-panel .panel-title {
    color: #a3e635;
}

.label-key {
    color: #8794a6;
    width: 13;
}

.metric-value {
    color: #e8edf3;
    background: #0d1218;
    border: solid #253241;
    padding: 0 1;
    width: 1fr;
    min-height: 3;
}

DataTable {
    height: 1fr;
    background: #0d1218;
    color: #d9e2ec;
    border: solid #253241;
}

DataTable > .datatable--header {
    background: #172635;
    color: #5eead4;
    text-style: bold;
}

DataTable > .datatable--odd-row {
    background: #101820;
}

DataTable > .datatable--cursor {
    background: #24354a;
}

DataTable:focus > .datatable--cursor {
    background: #315b68;
    color: #f8fbfc;
    text-style: bold;
}

DataTable:focus {
    border: tall #5eead4;
}

Input,
.subscription-input {
    height: 3;
    background: #0d1218;
    color: #e8edf3;
    border: solid #253241;
}

Input:focus,
.subscription-input:focus {
    border: tall #5eead4;
    background: #111a23;
}

TextArea {
    background: #0d1218;
    color: #d9e2ec;
}

TextArea:focus {
    border: tall #5eead4;
    background: #101820;
}

Checkbox {
    color: #d9e2ec;
    margin-left: 1;
    min-width: 16;
}

Checkbox:focus {
    color: #5eead4;
}

Switch {
    margin-right: 1;
}

.proxy-group-card {
    border: solid #2b394b;
    padding: 1 2;
    margin: 0 1 1 0;
    height: 1fr;
    background: #151c26;
}

.proxy-sidebar {
    border-left: tall #f2c166;
}

.proxy-main {
    border-left: tall #5eead4;
}

.split-sidebar {
    width: 2fr;
}

.split-main {
    width: 3fr;
}

.workbench-row {
    height: 1fr;
}

.proxy-group-title {
    color: #5eead4;
    text-style: bold;
    margin-bottom: 1;
}

.node-current {
    color: #a3e635;
    text-style: bold;
    margin-bottom: 1;
    min-height: 3;
    background: #0d1218;
    border: solid #253241;
    padding: 1 2;
}

.ai-route-panel {
    border: solid #2b394b;
    padding: 1 2;
    margin: 0 0 1 0;
    background: #151c26;
    width: 1fr;
    min-height: 8;
}

.ai-selector-panel {
    border-left: tall #f2c166;
}

.ai-chain-panel {
    border-left: tall #5eead4;
}

.ai-route-title {
    color: #f2c166;
    text-style: bold;
    margin-bottom: 1;
}

.log-viewer {
    height: 1fr;
    background: #0d1218;
    border: solid #2b394b;
    padding: 0 1;
}

.log-viewer:focus {
    border: tall #f2c166;
}

.config-editor {
    height: 1fr;
    border: solid #2b394b;
    padding: 0 1;
}

.config-editor:focus {
    border: tall #a3e635;
}

.subscription-input {
    width: 1fr;
    margin: 0 0 1 0;
}

.action-button {
    margin: 0 1 0 0;
    min-width: 12;
    height: 3;
    background: #1b2633;
    color: #e8edf3;
    border: solid #38485c;
}

.action-button:hover {
    background: #26364a;
    border: solid #5eead4;
}

.action-button:focus {
    border: tall #5eead4;
    background: #223348;
    text-style: bold;
}

.action-button.-active {
    background: #5eead4;
    color: #071013;
}

.primary-button {
    background: #165d72;
    color: #ecfeff;
    border: solid #0e92b0;
}

.primary-button:hover {
    background: #0e7490;
    border: solid #67e8f9;
}

.success-button {
    background: #365314;
    color: #f7fee7;
    border: solid #6ea61d;
}

.success-button:hover {
    background: #4d7c0f;
    border: solid #bef264;
}

.danger-button {
    background: #7c1d2a;
    color: #fff1f2;
    border: solid #c0264c;
}

.danger-button:hover {
    background: #991b1b;
    border: solid #fb7185;
}

.muted-button {
    background: #1a2230;
    color: #c8d3df;
    border: solid #334155;
}

.muted-button:hover {
    background: #243246;
    border: solid #64748b;
}

.notification {
    dock: bottom;
    height: 3;
    background: #5eead4;
    color: #071013;
    padding: 1;
}

.notification-error {
    background: #fb7185;
}

.notification-success {
    background: #a3e635;
}

#dashboard-grid {
    height: auto;
}

.dashboard-row {
    height: auto;
    margin-bottom: 1;
}

.field-row {
    height: auto;
    margin-bottom: 1;
}

.page-title {
    color: #e8edf3;
    text-style: bold;
    background: #151c26;
    border-left: tall #5eead4;
    border-bottom: solid #253241;
    margin: 0 0 1 0;
    padding: 0 1;
    min-height: 3;
}

.panel {
    border: solid #2b394b;
    background: #151c26;
    padding: 1 2;
    margin: 0 0 1 0;
}

.panel-title {
    color: #f2c166;
    text-style: bold;
    margin-bottom: 1;
}

.status-card-title,
.proxy-group-title,
.ai-route-title,
.panel-title {
    background: #101820;
    border-bottom: solid #253241;
    padding: 0 1;
}

.status-card:hover,
.proxy-group-card:hover,
.ai-route-panel:hover,
.panel:hover,
.metric-value:hover,
.node-current:hover,
.current-info:hover,
.path-label:hover,
.status-strip:hover,
.action-status:hover {
    border: solid #3b4b60;
}

.toolbar {
    height: auto;
    margin: 1 0;
}

.form-panel {
    height: auto;
    border-left: tall #5eead4;
}

.output-panel {
    height: 1fr;
    border-left: tall #f2c166;
}

.summary-panel {
    border-left: tall #a3e635;
}

.output-area {
    height: 1fr;
    border: solid #2b394b;
    background: #0d1218;
}

.output-area:focus {
    border: tall #f2c166;
}

.current-info {
    color: #d9e2ec;
    background: #0d1218;
    border: solid #2b394b;
    padding: 1 2;
    min-height: 6;
}

.path-label {
    color: #8794a6;
    background: #0d1218;
    border: solid #253241;
    padding: 0 1;
    width: 1fr;
}

.status-strip {
    color: #d9e2ec;
    background: #0d1218;
    border: solid #253241;
    padding: 0 1;
    min-height: 3;
}

.action-status {
    color: #d9e2ec;
    background: #0d1218;
    border: solid #253241;
    padding: 0 1;
    min-height: 3;
    margin-top: 1;
}
